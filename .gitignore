# ==========================================
# Zolaha Product Ecosystem - Git Ignore Rules
# ==========================================

# OS Generated Files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Editor & IDE Configs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
secrets.json

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json.bak

# Build & Output Artifacts
dist/
build/
out/
.cache/
temp/
tmp/
*.zip
*.tar.gz

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*

# WordPress & PHP (if synchronized with hosting)
wp-config.php
wp-content/uploads/
wp-content/upgrade/
wp-content/backup-db/
wp-content/cache/
*.sql
*.sql.gz

# Antigravity & Agent Scratch Files
.system_generated/
scratch/
temp_skill/
